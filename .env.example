# Base URL of the gptproto materials API used to generate the README.
# Run the gptproto-growth app locally and point this at it, or use a deployed instance.
MATERIALS_API_BASE=http://localhost:3000

# GitHub Actions: add repo secret MATERIALS_API_BASE (production API URL, no trailing slash).
# Optional repo variable SITE_URL if not https://gptproto.com

# Public website that receives the backlinks (no trailing slash).
SITE_URL=https://gptproto.com

# Set OFFLINE=1 to regenerate from data/snapshot.json (needs source + byLocale for all 11 langs).
# OFFLINE=1

# README.md uses ?lang=en. Other files: README_es.md, README_ja.md, …
# Executable originals: docs/PROMPTS_ORIGINAL.md (source layer only).
